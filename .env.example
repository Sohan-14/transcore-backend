# Copy to .env for local development:  cp .env.example .env

# ===============================================================
# Application
# ===============================================================
APP_NAME=transcore-backend
# REQUIRED. One of: development | staging | production
APP_ENV=development

# ===============================================================
# HTTP
# ===============================================================
# REQUIRED: host:port
HTTP_ADDR=:8080
# Durations use Go syntax with a unit: 500ms, 5s, 2m.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_DRAIN_DELAY=0s
# Largest accepted request body 1048576 = 1 MiB.
HTTP_MAX_BODY_BYTES=1048576
# Largest accepted request body 65536 = 64 KiB.
HTTP_MAX_HEADER_BYTES=65536
# ===============================================================
# Logging
# ===============================================================
# debug | info | warn | error
LOG_LEVEL=debug
# json | text
LOG_FORMAT=json
LOG_ADD_SOURCE=false

# ===============================================================
# Database
# ===============================================================
# REQUIRED: Production requires sslmode=require, verify-ca or verify-full.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_starter?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=transcore
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_STARTUP_TIMEOUT=5s
DB_HEALTH_TIMEOUT=3s


